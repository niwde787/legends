rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // --- PRIMITIVE HELPERS ---
    function incoming() { return request.resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // --- VALIDATION BLUEPRINTS ---
    function isValidUserEmail(data) {
      return data.keys().hasAll(['email', 'createdAt']) && 
             data.keys().size() == 2 &&
             data.email is string && data.email.size() <= 254 && data.email.matches('^.+@.+\\..+$') &&
             data.createdAt == request.time;
    }

    // --- COLLECTION RULES ---
    
    // Emails Collection
    match /emails/{emailId} {
      allow get: if isValidId(emailId); // allow reading own doc to check existence
      allow create, update: if isValidId(emailId) && isValidUserEmail(incoming());
    }

    // Stats Collection
    match /stats/global {
      allow read: if true;
      allow create: if incoming().keys().hasAny(['totalGamesPlayed', 'totalUsers']);
      allow update: if incoming().diff(resource.data).affectedKeys().hasOnly(['totalGamesPlayed', 'totalUsers']);
    }
  }
}
